# Frontend: configuração pública do aplicativo web Firebase
VITE_API_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=chave-publica-do-app-web
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-firebase
VITE_FIREBASE_APP_ID=id-publico-do-app-web

# Backend: projeto e credencial privada do Firebase Admin
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIRESTORE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=backend/credencial.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
